# Copy this file to android/key.properties and fill in the real values.
# NEVER commit key.properties or your .jks file, and keep a backup of the keystore:
# if you lose it you can never update your app on Google Play.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=C:/path/to/upload-keystore.jks
